#!/bin/busybox sh
# Debug initramfs for CMF Phone 1 (Tetris): load first-stage MTK modules,
# bring up a USB NCM gadget and offer a telnet shell on 172.16.42.1.
# Never exits (PID 1 exiting = kernel panic).

/bin/busybox --install -s /bin
export PATH=/bin

mkdir -p /proc /sys /dev /tmp /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config 2>/dev/null

LOG=/tmp/init.log
exec >"$LOG" 2>&1
echo "init: $(uname -a)"

# Persist progress across a forced reboot: pstore pmsg (512K, survives warm reset,
# readable under Android as /sys/fs/pstore/pmsg-ramoops-0).
pmsg() { [ -c /dev/pmsg0 ] && { echo "== $1"; tail -c 120000 "$LOG"; dmesg | tail -c 300000; } > /dev/pmsg0 2>/dev/null; }
pmsg "init started"

# Persist to flash once UFS is up: nt_reserve2 (64M, empty on stock; backup in
# stock-info/nt_reserve2.img.gz). Layout: 0 = init log, 16M = latest dmesg.
# Read back under Android: dd if=/dev/block/by-name/nt_reserve2 bs=1M count=16 | strings
LOGDEV=
find_logdev() {
    local u
    for u in /sys/class/block/*/uevent; do
        grep -qx PARTNAME=nt_reserve2 "$u" && LOGDEV=/dev/$(sed -n 's/^DEVNAME=//p' "$u") && return 0
    done
    return 1
}
flog() { # flog <message>: append to init log and sync log + dmesg to flash
    echo "$*"
    [ -n "$LOGDEV" ] || return 0
    dd if="$LOG" of="$LOGDEV" bs=64k conv=fsync,notrunc 2>/dev/null
    dmesg | tail -c 2000000 > /tmp/dmesg.snap
    dd if=/tmp/dmesg.snap of="$LOGDEV" bs=1M seek=16 conv=fsync,notrunc 2>/dev/null
}

KVER=$(uname -r)
MODDIR=/lib/modules/$KVER
load_stage() { # load_stage <list>  (stock order, deps via modules.dep; each name is
               #  logged to pmsg first, so a hanging load shows up as the last line there)
    local m loaded=0 failed=0
    while read -r m; do
        [ -z "$m" ] && continue
        flog "init: load $m"; echo "load $m" > /dev/pmsg0 2>/dev/null
        # Our RT6010 haptic port claims the chip before the vendor haptic.ko (stage 1) binds it,
        # so no unbind is needed later. Unbinding the vendor driver resets the phone.
        if [ "$m" = haptic.ko ] && [ -e "$MODDIR/rt6010-haptic.ko" ]; then
            modprobe rt6010-haptic && flog "init: rt6010-haptic claims the chip first"
        fi
        if modprobe "${m%.ko}"; then loaded=$((loaded+1)); else failed=$((failed+1)); echo "init: FAIL $m"; fi
    done < "$MODDIR/$1"
    echo "init: $1 loaded=$loaded failed=$failed"
}
load_stage modules.load
pmsg "stage 1 loaded"
# UFS driver is in stage 1; wipe our log area once and start persisting
if find_logdev; then
    dd if=/dev/zero of="$LOGDEV" bs=1M count=20 conv=fsync 2>/dev/null
    flog "init: flash log on $LOGDEV ($(date))"
else
    echo "init: nt_reserve2 not found"
fi
load_stage modules.load.2
pmsg "stage 2 loaded"
flog "init: stage 2 done"
load_stage modules.load.3
flog "init: stage 3 done"

# WLAN calibration data: the gen4m driver only registers with conninfra once it got NVRAM
# ("WR-BUF:NVRAM" + data in ONE write to /dev/wmtWifi, like Android's wlan_assistant).
# Must happen before the first display unblank, which triggers conninfra's pre-cal.
for u in /sys/class/block/*/uevent; do
    grep -qx PARTNAME=nvdata "$u" && NVDEV=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
done
mkdir -p /mnt/nvdata
if [ -n "$NVDEV" ] && mount -t ext4 -o ro "$NVDEV" /mnt/nvdata; then
    if [ -f /mnt/nvdata/APCFG/APRDEB/WIFI ] && [ -c /dev/wmtWifi ]; then
        { printf 'WR-BUF:NVRAM'; cat /mnt/nvdata/APCFG/APRDEB/WIFI; } > /tmp/wifi_nvram.buf
        dd if=/tmp/wifi_nvram.buf of=/dev/wmtWifi bs=65536 count=1 2>/dev/null &&
            flog "init: WLAN NVRAM written" || flog "init: WLAN NVRAM write failed"
    fi
    umount /mnt/nvdata
fi

# Wait for the UDC (mtu3) to appear
for i in $(seq 50); do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] && break
    sleep 0.2
done
echo "init: UDC=$UDC"

# mtu3 only connects once the type-C stack assigns a data role; force device mode.
for r in /sys/class/usb_role/*/role; do
    [ -e "$r" ] && echo device > "$r" && echo "init: $r -> $(cat "$r")"
done

G=/sys/kernel/config/usb_gadget/g1
if [ -n "$UDC" ] && mkdir -p $G; then
    echo 0x18d1 > $G/idVendor          # Google
    echo 0xd001 > $G/idProduct         # generic "Nexus4 NCM"-style id used by postmarketOS
    mkdir -p $G/strings/0x409
    echo "CMF"                > $G/strings/0x409/manufacturer
    echo "Tetris Linux debug" > $G/strings/0x409/product
    echo "tetris-debug"       > $G/strings/0x409/serialnumber
    mkdir -p $G/functions/ncm.usb0 $G/configs/c.1/strings/0x409
    echo "NCM" > $G/configs/c.1/strings/0x409/configuration
    ln -s $G/functions/ncm.usb0 $G/configs/c.1/
    echo "$UDC" > $G/UDC
    sleep 1
fi

IF=$(cat $G/functions/ncm.usb0/ifname 2>/dev/null); IF=${IF:-usb0}
ip addr add 172.16.42.1/24 dev "$IF"
ip link set "$IF" up
ip link set lo up
echo "start 172.16.42.2
end 172.16.42.2
interface $IF
option subnet 255.255.255.0
max_leases 1" > /tmp/udhcpd.conf
touch /tmp/udhcpd.leases
udhcpd /tmp/udhcpd.conf
telnetd -l /bin/sh -p 23
echo "init: telnet on 172.16.42.1:23 via $IF"
pmsg "network up"
flog "init: network up"

dmesg > /tmp/dmesg.boot

# Escape hatch: any key event (volume keys) in a 3 s window -> stay in debug initramfs.
KEYPRESS=
for e in /sys/class/input/event*; do
    case "$(cat "$e/device/name" 2>/dev/null)" in
        gpio-keys|mtk-pmic-keys) KEYDEVS="$KEYDEVS /dev/input/${e##*/}" ;;
    esac
done
# Tux on the display (after the WLAN NVRAM write above: the first unblank starts
# conninfra's pre-cal). Keeps running across switch_root; tetris-splash-stop.service ends it.
setsid tetris-splash /etc/tux.ppm </dev/null >/dev/null 2>&1 &
for k in $KEYDEVS; do (timeout 3 head -c 24 "$k" > /tmp/key.${k##*/}) & done
sleep 3.2
for f in /tmp/key.*; do [ -s "$f" ] && KEYPRESS=1; done
[ -n "$KEYPRESS" ] && flog "init: key pressed -> debug mode"
# out/debug-vendor_boot-shell.img adds tetris.debug=1 to the cmdline: always stay here
grep -qw tetris.debug=1 /proc/cmdline && KEYPRESS=1 && flog "init: tetris.debug=1 -> debug mode"

# Boot Arch from userdata (ext4) unless it's missing, /.tetris-debug exists or a key was pressed.
ROOTDEV=
for u in /sys/class/block/*/uevent; do
    grep -qx PARTNAME=userdata "$u" && ROOTDEV=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
done
mkdir -p /newroot
if [ -n "$ROOTDEV" ] && mount -t ext4 -o rw "$ROOTDEV" /newroot; then
    if [ -x /newroot/usr/lib/systemd/systemd ] && [ ! -e /newroot/.tetris-debug ] && [ -z "$KEYPRESS" ]; then
        flog "init: switch_root to $ROOTDEV"
        cp "$LOG" /newroot/var/log/tetris-initramfs.log 2>/dev/null
        killall telnetd udhcpd 2>/dev/null
        # The NCM gadget stays configured; systemd-networkd takes over usb0.
        umount /sys/kernel/config 2>/dev/null
        mount --move /dev /newroot/dev
        mount --move /proc /newroot/proc
        mount --move /sys /newroot/sys
        umount /tmp
        exec switch_root /newroot /usr/lib/systemd/systemd
    fi
    flog "init: staying in debug initramfs (rootfs incomplete or /.tetris-debug)"
    umount /newroot
else
    flog "init: no ext4 rootfs on userdata ($ROOTDEV), staying in debug initramfs"
fi

while true; do sleep 30; pmsg "heartbeat"; flog "init: heartbeat $(cut -d' ' -f1 /proc/uptime)"; done
