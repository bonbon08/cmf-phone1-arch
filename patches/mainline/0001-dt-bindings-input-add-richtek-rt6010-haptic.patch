+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/richtek,rt6010-haptic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Richtek RT6010 haptic driver for LRA actuators
+
+maintainers:
+  - CMF Phone 1 (Tetris) port
+
+description: |
+  The RT6010 drives a linear resonant actuator (LRA) over I2C and plays back
+  waveforms stored in its RAM. The driver exposes the actuator as a
+  force-feedback input device. The chip configuration is read from the firmware
+  file haptic_config.bin.
+
+properties:
+  compatible:
+    oneOf:
+      - const: richtek,rt6010
+      - description: vendor device tree of the CMF Phone 1, same chip
+        const: ics,haptic_rt
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    description: GPIO that powers and resets the chip (active high).
+    maxItems: 1
+
+  gpio-en:
+    description: vendor name of enable-gpios, accepted by kernels before 6.3 (vendor device tree).
+    maxItems: 1
+
+anyOf:
+  - required: [enable-gpios]
+  - required: [gpio-en]
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        haptic@5f {
+            compatible = "richtek,rt6010";
+            reg = <0x5f>;
+            enable-gpios = <&pio 74 GPIO_ACTIVE_HIGH>;
+        };
+    };
+...
