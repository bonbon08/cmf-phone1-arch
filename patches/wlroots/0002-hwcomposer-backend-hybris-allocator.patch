diff --git a/backend/hwcomposer/backend.c b/backend/hwcomposer/backend.c
new file mode 100644
index 0000000..3620a85
--- /dev/null
+++ b/backend/hwcomposer/backend.c
@@ -0,0 +1,228 @@
+#include <assert.h>
+#include <dlfcn.h>
+#include <drm_fourcc.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <wlr/backend/hwcomposer.h>
+#include <wlr/backend/multi.h>
+#include <wlr/util/log.h>
+#include "backend/hwcomposer.h"
+
+/*
+ * Android hwcomposer backend: the display is driven by the composer HAL (HWC2,
+ * through libhybris' libhwc2), wlroots renders with GLES on libhybris' EGL into
+ * gralloc buffers (render/allocator/hybris.c) that are presented as the HWC2
+ * client target.
+ */
+
+static const struct wlr_backend_impl backend_impl;
+
+struct wlr_hwcomposer_backend *hwcomposer_backend_from_backend(
+		struct wlr_backend *wlr_backend) {
+	assert(wlr_backend_is_hwcomposer(wlr_backend));
+	struct wlr_hwcomposer_backend *backend = wl_container_of(wlr_backend, backend, backend);
+	return backend;
+}
+
+bool wlr_backend_is_hwcomposer(struct wlr_backend *backend) {
+	return backend->impl == &backend_impl;
+}
+
+static void find_hwcomposer(struct wlr_backend *backend, void *data) {
+	bool *found = data;
+	*found = *found || wlr_backend_is_hwcomposer(backend);
+}
+
+bool wlr_backend_has_hwcomposer(struct wlr_backend *backend) {
+	if (wlr_backend_is_multi(backend)) {
+		bool found = false;
+		wlr_multi_for_each_backend(backend, find_hwcomposer, &found);
+		return found;
+	}
+	return wlr_backend_is_hwcomposer(backend);
+}
+
+static bool backend_start(struct wlr_backend *wlr_backend) {
+	struct wlr_hwcomposer_backend *backend = hwcomposer_backend_from_backend(wlr_backend);
+	wlr_log(WLR_INFO, "Starting hwcomposer backend");
+
+	backend->output = hwcomposer_output_create(backend);
+	if (backend->output == NULL) {
+		return false;
+	}
+	backend->started = true;
+	wl_signal_emit_mutable(&backend->backend.events.new_output,
+		&backend->output->wlr_output);
+	return true;
+}
+
+static void backend_destroy(struct wlr_backend *wlr_backend) {
+	if (!wlr_backend) {
+		return;
+	}
+	struct wlr_hwcomposer_backend *backend = hwcomposer_backend_from_backend(wlr_backend);
+
+	wlr_backend_finish(wlr_backend);
+	if (backend->output != NULL) {
+		wlr_output_destroy(&backend->output->wlr_output);
+	}
+	if (backend->display != NULL) {
+		backend->hwc2.display_set_power_mode(backend->display, HWC2_POWER_MODE_OFF);
+	}
+	wlr_drm_format_set_finish(&backend->primary_formats);
+	wl_list_remove(&backend->event_loop_destroy.link);
+	// libhwc2 stays loaded: its binder threads may still call into it
+	free(backend);
+}
+
+static const struct wlr_backend_impl backend_impl = {
+	.start = backend_start,
+	.destroy = backend_destroy,
+};
+
+static void handle_event_loop_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_hwcomposer_backend *backend =
+		wl_container_of(listener, backend, event_loop_destroy);
+	backend_destroy(&backend->backend);
+}
+
+/* HWC2 callbacks arrive on binder threads; only hotplug needs handling, and
+ * libhwc2 wants it fed back into the device (as libhybris' own tests do). */
+static void handle_vsync(struct hwc2_event_listener *listener, int32_t seq,
+		hwc2_display_t display, int64_t timestamp) {
+}
+
+static void handle_hotplug(struct hwc2_event_listener *listener, int32_t seq,
+		hwc2_display_t display, bool connected, bool primary) {
+	struct wlr_hwcomposer_backend *backend = wl_container_of(listener, backend, listener);
+	wlr_log(WLR_INFO, "hwcomposer: hotplug display %"PRIu64" connected=%d primary=%d",
+		display, connected, primary);
+	backend->hwc2.device_on_hotplug(backend->device, display, connected);
+}
+
+static void handle_refresh(struct hwc2_event_listener *listener, int32_t seq,
+		hwc2_display_t display) {
+}
+
+static bool load_hwc2(struct hwc2_api *api) {
+	// libhybris' libhwc2 (needs libhybris' libraries on the library path)
+	api->lib = dlopen("libhwc2.so.1", RTLD_NOW | RTLD_GLOBAL);
+	if (api->lib == NULL) {
+		wlr_log(WLR_ERROR, "hwcomposer: cannot load libhwc2.so.1: %s", dlerror());
+		return false;
+	}
+
+	// memcpy: object pointer -> function pointer without type punning
+#define LOAD(field, sym) do { \
+		void *addr = dlsym(api->lib, sym); \
+		if (addr == NULL) { \
+			wlr_log(WLR_ERROR, "hwcomposer: libhwc2 lacks %s", sym); \
+			return false; \
+		} \
+		memcpy(&api->field, &addr, sizeof(addr)); \
+	} while (0)
+	LOAD(device_new, "hwc2_compat_device_new");
+	LOAD(device_register_callback, "hwc2_compat_device_register_callback");
+	LOAD(device_on_hotplug, "hwc2_compat_device_on_hotplug");
+	LOAD(device_get_display_by_id, "hwc2_compat_device_get_display_by_id");
+	LOAD(display_get_active_config, "hwc2_compat_display_get_active_config");
+	LOAD(display_accept_changes, "hwc2_compat_display_accept_changes");
+	LOAD(display_create_layer, "hwc2_compat_display_create_layer");
+	LOAD(display_get_release_fences, "hwc2_compat_display_get_release_fences");
+	LOAD(display_present, "hwc2_compat_display_present");
+	LOAD(display_set_client_target, "hwc2_compat_display_set_client_target");
+	LOAD(display_set_power_mode, "hwc2_compat_display_set_power_mode");
+	LOAD(display_validate, "hwc2_compat_display_validate");
+	LOAD(layer_set_blend_mode, "hwc2_compat_layer_set_blend_mode");
+	LOAD(layer_set_composition_type, "hwc2_compat_layer_set_composition_type");
+	LOAD(layer_set_display_frame, "hwc2_compat_layer_set_display_frame");
+	LOAD(layer_set_source_crop, "hwc2_compat_layer_set_source_crop");
+	LOAD(layer_set_visible_region, "hwc2_compat_layer_set_visible_region");
+	LOAD(out_fences_destroy, "hwc2_compat_out_fences_destroy");
+#undef LOAD
+	return true;
+}
+
+struct wlr_backend *wlr_hwcomposer_backend_create(struct wl_event_loop *loop) {
+	wlr_log(WLR_INFO, "Creating hwcomposer backend");
+
+	struct wlr_hwcomposer_backend *backend = calloc(1, sizeof(*backend));
+	if (backend == NULL) {
+		wlr_log(WLR_ERROR, "Failed to allocate wlr_hwcomposer_backend");
+		return NULL;
+	}
+
+	if (!load_hwc2(&backend->hwc2)) {
+		free(backend);
+		return NULL;
+	}
+
+	backend->device = backend->hwc2.device_new(false);
+	if (backend->device == NULL) {
+		wlr_log(WLR_ERROR, "hwcomposer: cannot connect to the composer HAL");
+		free(backend);
+		return NULL;
+	}
+	backend->listener = (struct hwc2_event_listener){
+		.on_vsync_received = handle_vsync,
+		.on_hotplug_received = handle_hotplug,
+		.on_refresh_received = handle_refresh,
+	};
+	backend->hwc2.device_register_callback(backend->device, &backend->listener, 0);
+
+	// The primary display shows up through the (asynchronous) hotplug callback
+	for (int i = 0; i < 50 && backend->display == NULL; i++) {
+		backend->display = backend->hwc2.device_get_display_by_id(backend->device, 0);
+		if (backend->display == NULL) {
+			nanosleep(&(struct timespec){ .tv_nsec = 100 * 1000 * 1000 }, NULL);
+		}
+	}
+	if (backend->display == NULL) {
+		wlr_log(WLR_ERROR, "hwcomposer: primary display did not appear");
+		free(backend);
+		return NULL;
+	}
+
+	backend->hwc2.display_set_power_mode(backend->display, HWC2_POWER_MODE_ON);
+	struct hwc2_display_config *config =
+		backend->hwc2.display_get_active_config(backend->display);
+	if (config == NULL) {
+		wlr_log(WLR_ERROR, "hwcomposer: no active display config");
+		free(backend);
+		return NULL;
+	}
+	backend->config = *config;
+	wlr_log(WLR_INFO, "hwcomposer: display %"PRId32"x%"PRId32", vsync %"PRId64" ns, "
+		"dpi %.1fx%.1f", config->width, config->height, config->vsync_period,
+		config->dpi_x, config->dpi_y);
+
+	// One full-screen client-composited layer; wlroots composites everything
+	backend->layer = backend->hwc2.display_create_layer(backend->display);
+	int w = config->width, h = config->height;
+	backend->hwc2.layer_set_composition_type(backend->layer, HWC2_COMPOSITION_CLIENT);
+	backend->hwc2.layer_set_blend_mode(backend->layer, HWC2_BLEND_MODE_NONE);
+	backend->hwc2.layer_set_source_crop(backend->layer, 0.0f, 0.0f, w, h);
+	backend->hwc2.layer_set_display_frame(backend->layer, 0, 0, w, h);
+	backend->hwc2.layer_set_visible_region(backend->layer, 0, 0, w, h);
+
+	// XRGB/ARGB first: wlroots prefers them for primary buffers (HAL BGRA_8888)
+	wlr_drm_format_set_add(&backend->primary_formats, DRM_FORMAT_XRGB8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&backend->primary_formats, DRM_FORMAT_ARGB8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&backend->primary_formats, DRM_FORMAT_XBGR8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&backend->primary_formats, DRM_FORMAT_ABGR8888,
+		DRM_FORMAT_MOD_INVALID);
+
+	wlr_backend_init(&backend->backend, &backend_impl);
+	backend->backend.buffer_caps = WLR_BUFFER_CAP_DMABUF;
+	backend->event_loop = loop;
+	backend->event_loop_destroy.notify = handle_event_loop_destroy;
+	wl_event_loop_add_destroy_listener(loop, &backend->event_loop_destroy);
+
+	return &backend->backend;
+}
diff --git a/backend/hwcomposer/meson.build b/backend/hwcomposer/meson.build
new file mode 100644
index 0000000..a283368
--- /dev/null
+++ b/backend/hwcomposer/meson.build
@@ -0,0 +1,20 @@
+# Android hwcomposer backend (libhybris' libhwc2 is dlopen()ed at runtime) and the
+# gralloc allocator it renders into. Needs the gles2 renderer.
+if get_option('hwcomposer').disabled()
+	subdir_done()
+endif
+if not internal_features['egl']
+	if get_option('hwcomposer').enabled()
+		error('The hwcomposer backend needs the GLES2 renderer (EGL)')
+	endif
+	subdir_done()
+endif
+
+wlr_files += files(
+	'backend.c',
+	'output.c',
+	'../../render/allocator/hybris.c',
+	'../../render/hybris_wl_buffer.c',
+)
+wlr_deps += cc.find_library('dl', required: false)
+internal_features += { 'hwcomposer': true }
diff --git a/backend/hwcomposer/output.c b/backend/hwcomposer/output.c
new file mode 100644
index 0000000..0ad4f8d
--- /dev/null
+++ b/backend/hwcomposer/output.c
@@ -0,0 +1,232 @@
+#include <assert.h>
+#include <inttypes.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+#include <wlr/backend/hwcomposer.h>
+#include <wlr/interfaces/wlr_output.h>
+#include <wlr/types/wlr_output_layer.h>
+#include <wlr/util/log.h>
+#include "backend/hwcomposer.h"
+#include "render/hybris.h"
+#include "types/wlr_output.h"
+
+static const uint32_t SUPPORTED_OUTPUT_STATE =
+	WLR_OUTPUT_STATE_BACKEND_OPTIONAL |
+	WLR_OUTPUT_STATE_BUFFER |
+	WLR_OUTPUT_STATE_ENABLED |
+	WLR_OUTPUT_STATE_MODE |
+	/* rotation: the renderer draws rotated into the native-size buffer */
+	WLR_OUTPUT_STATE_TRANSFORM;
+
+static const struct wlr_output_impl output_impl;
+
+bool wlr_output_is_hwcomposer(struct wlr_output *wlr_output) {
+	return wlr_output->impl == &output_impl;
+}
+
+static struct wlr_hwcomposer_output *hwcomposer_output_from_output(
+		struct wlr_output *wlr_output) {
+	assert(wlr_output_is_hwcomposer(wlr_output));
+	struct wlr_hwcomposer_output *output = wl_container_of(wlr_output, output, wlr_output);
+	return output;
+}
+
+static bool output_test(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	struct wlr_hwcomposer_output *output = hwcomposer_output_from_output(wlr_output);
+	struct hwc2_display_config *config = &output->backend->config;
+
+	uint32_t unsupported = state->committed & ~SUPPORTED_OUTPUT_STATE;
+	if (unsupported != 0) {
+		wlr_log(WLR_DEBUG, "Unsupported output state fields: 0x%"PRIx32, unsupported);
+		return false;
+	}
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		int32_t width = state->mode_type == WLR_OUTPUT_STATE_MODE_FIXED ?
+			state->mode->width : state->custom_mode.width;
+		int32_t height = state->mode_type == WLR_OUTPUT_STATE_MODE_FIXED ?
+			state->mode->height : state->custom_mode.height;
+		if (width != config->width || height != config->height) {
+			wlr_log(WLR_DEBUG, "hwcomposer: only the native mode is supported");
+			return false;
+		}
+	}
+	// Only our own gralloc buffers can be client targets (no direct scan-out
+	// of client buffers)
+	if ((state->committed & WLR_OUTPUT_STATE_BUFFER) &&
+			!wlr_buffer_is_hybris(state->buffer)) {
+		return false;
+	}
+	if (state->committed & WLR_OUTPUT_STATE_LAYERS) {
+		for (size_t i = 0; i < state->layers_len; i++) {
+			state->layers[i].accepted = false;
+		}
+	}
+	return true;
+}
+
+static bool present_buffer(struct wlr_hwcomposer_output *output, struct wlr_buffer *buffer) {
+	struct wlr_hwcomposer_backend *backend = output->backend;
+	struct hwc2_api *hwc2 = &backend->hwc2;
+
+	uint32_t num_types = 0, num_requests = 0;
+	hwc2_error_t err = hwc2->display_validate(backend->display, &num_types, &num_requests);
+	if (err != HWC2_ERROR_NONE && err != HWC2_ERROR_HAS_CHANGES) {
+		wlr_log(WLR_ERROR, "hwcomposer: validate failed (%d)", err);
+		return false;
+	}
+	if (num_types || num_requests) {
+		err = hwc2->display_accept_changes(backend->display);
+		if (err != HWC2_ERROR_NONE) {
+			wlr_log(WLR_ERROR, "hwcomposer: accept changes failed (%d)", err);
+			return false;
+		}
+	}
+
+	// The gles2 render pass glFinish()es hybris buffers, so no acquire fence
+	err = hwc2->display_set_client_target(backend->display,
+		wlr_hybris_buffer_get_slot(buffer), wlr_hybris_buffer_get_native(buffer),
+		-1, HAL_DATASPACE_UNKNOWN);
+	if (err != HWC2_ERROR_NONE) {
+		wlr_log(WLR_ERROR, "hwcomposer: set client target failed (%d)", err);
+		return false;
+	}
+
+	int32_t present_fence = -1;
+	err = hwc2->display_present(backend->display, &present_fence);
+	if (err != HWC2_ERROR_NONE) {
+		wlr_log(WLR_ERROR, "hwcomposer: present failed (%d)", err);
+		return false;
+	}
+	void *fences = NULL;
+	if (hwc2->display_get_release_fences(backend->display, &fences) == HWC2_ERROR_NONE &&
+			fences != NULL) {
+		hwc2->out_fences_destroy(fences);
+	}
+	// The present fence signals once this frame is on screen, i.e. the composer
+	// is done with the previous client target. Waiting here (bounded, about a
+	// refresh) keeps the swapchain from handing that buffer back to the renderer
+	// while it's still being scanned out, which showed up as glitches.
+	if (present_fence >= 0) {
+		struct pollfd pfd = { .fd = present_fence, .events = POLLIN };
+		if (poll(&pfd, 1, 50) <= 0) {
+			wlr_log(WLR_DEBUG, "hwcomposer: present fence not signalled in 50 ms");
+		}
+		close(present_fence);
+	}
+	return true;
+}
+
+static bool output_commit(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	struct wlr_hwcomposer_output *output = hwcomposer_output_from_output(wlr_output);
+	struct wlr_hwcomposer_backend *backend = output->backend;
+
+	if (!output_test(wlr_output, state)) {
+		return false;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_ENABLED) {
+		backend->hwc2.display_set_power_mode(backend->display,
+			state->enabled ? HWC2_POWER_MODE_ON : HWC2_POWER_MODE_OFF);
+	}
+
+	if (!output_pending_enabled(wlr_output, state)) {
+		return true;
+	}
+
+	if ((state->committed & WLR_OUTPUT_STATE_BUFFER) &&
+			!present_buffer(output, state->buffer)) {
+		return false;
+	}
+
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	struct wlr_output_event_present present_event = {
+		.commit_seq = wlr_output->commit_seq + 1,
+		.presented = true,
+		.when = now,
+		.refresh = (int)backend->config.vsync_period,
+	};
+	output_defer_present(wlr_output, present_event);
+	wl_event_source_timer_update(output->frame_timer, output->frame_delay);
+	return true;
+}
+
+static void output_destroy(struct wlr_output *wlr_output) {
+	struct wlr_hwcomposer_output *output = hwcomposer_output_from_output(wlr_output);
+	wl_list_remove(&output->mode.link);
+	wlr_output_finish(wlr_output);
+	wl_event_source_remove(output->frame_timer);
+	output->backend->output = NULL;
+	free(output);
+}
+
+static const struct wlr_drm_format_set *output_get_primary_formats(
+		struct wlr_output *wlr_output, uint32_t buffer_caps) {
+	struct wlr_hwcomposer_output *output = hwcomposer_output_from_output(wlr_output);
+	return &output->backend->primary_formats;
+}
+
+static const struct wlr_output_impl output_impl = {
+	.destroy = output_destroy,
+	.test = output_test,
+	.commit = output_commit,
+	.get_primary_formats = output_get_primary_formats,
+};
+
+static int signal_frame(void *data) {
+	struct wlr_hwcomposer_output *output = data;
+	wlr_output_send_frame(&output->wlr_output);
+	return 0;
+}
+
+struct wlr_hwcomposer_output *hwcomposer_output_create(
+		struct wlr_hwcomposer_backend *backend) {
+	struct hwc2_display_config *config = &backend->config;
+	struct wlr_hwcomposer_output *output = calloc(1, sizeof(*output));
+	if (output == NULL) {
+		wlr_log(WLR_ERROR, "Failed to allocate wlr_hwcomposer_output");
+		return NULL;
+	}
+	output->backend = backend;
+
+	int64_t period = config->vsync_period > 0 ? config->vsync_period : 16666667;
+	int32_t refresh_mhz = (int32_t)(1000000000000LL / period);
+	output->frame_delay = (int)(period / 1000000);
+
+	// A real (preferred) mode rather than a custom one: compositors like phoc
+	// derive the output scale from it
+	output->mode = (struct wlr_output_mode){
+		.width = config->width,
+		.height = config->height,
+		.refresh = refresh_mhz,
+		.preferred = true,
+	};
+
+	struct wlr_output *wlr_output = &output->wlr_output;
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_mode(&state, &output->mode);
+	wlr_output_init(wlr_output, &backend->backend, &output_impl, backend->event_loop, &state);
+	wlr_output_state_finish(&state);
+	wl_list_insert(&wlr_output->modes, &output->mode.link);
+
+	// HWC reports dots per inch (sometimes x1000); fall back to nothing if bogus
+	float dpi_x = config->dpi_x > 10000 ? config->dpi_x / 1000 : config->dpi_x;
+	float dpi_y = config->dpi_y > 10000 ? config->dpi_y / 1000 : config->dpi_y;
+	if (dpi_x > 50 && dpi_y > 50) {
+		wlr_output->phys_width = (int)(config->width * 25.4f / dpi_x);
+		wlr_output->phys_height = (int)(config->height * 25.4f / dpi_y);
+	}
+
+	/* A built-in panel name: phoc only maps the touchscreen to (and rotates touch with)
+	 * outputs named LVDS-/eDP-/DSI-/DPI-; this is the same panel DRM calls DSI-1 */
+	wlr_output_set_name(wlr_output, "DSI-1");
+	wlr_output_set_description(wlr_output, "Android hwcomposer primary display");
+
+	output->frame_timer = wl_event_loop_add_timer(backend->event_loop, signal_frame, output);
+	return output;
+}
