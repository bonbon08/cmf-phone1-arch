diff --git a/render/allocator/hybris.c b/render/allocator/hybris.c
new file mode 100644
index 0000000..3be12ca
--- /dev/null
+++ b/render/allocator/hybris.c
@@ -0,0 +1,218 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <EGL/egl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include "render/hybris.h"
+
+/*
+ * gralloc buffers allocated through libhybris (eglHybrisCreateNativeBuffer). They're
+ * rendered into via EGL_NATIVE_BUFFER_ANDROID images (render/gles2) and scanned out
+ * as hwcomposer client targets (backend/hwcomposer).
+ */
+
+/* Mirrors of the Android structs we read; layout from nativebase.h / native_handle.h. */
+struct hybris_native_handle {
+	int version;
+	int num_fds;
+	int num_ints;
+	int data[];
+};
+
+struct hybris_native_buffer {
+	struct {
+		int magic;
+		int version;
+		void *reserved[4];
+		void (*inc_ref)(void *base);
+		void (*dec_ref)(void *base);
+	} common;
+	int width;
+	int height;
+	int stride;		/* in pixels */
+	int format;
+	int usage_deprecated;
+	uintptr_t layer_count;
+	void *reserved[1];
+	const struct hybris_native_handle *handle;
+	uint64_t usage;
+};
+
+#define HAL_PIXEL_FORMAT_RGBA_8888 1
+#define HAL_PIXEL_FORMAT_RGBX_8888 2
+#define GRALLOC_USAGE_HW_TEXTURE 0x100
+#define GRALLOC_USAGE_HW_RENDER 0x200
+#define GRALLOC_USAGE_HW_COMPOSER 0x800
+
+typedef EGLBoolean (*create_native_buffer_func)(EGLint width, EGLint height, EGLint usage,
+	EGLint format, EGLint *stride, EGLClientBuffer *buffer);
+typedef EGLBoolean (*release_native_buffer_func)(EGLClientBuffer buffer);
+
+struct hybris_allocator {
+	struct wlr_allocator base;
+	create_native_buffer_func create_native_buffer;
+	release_native_buffer_func release_native_buffer;
+	uint32_t next_slot;
+};
+
+struct hybris_buffer {
+	struct wlr_buffer base;
+	struct hybris_native_buffer *native;
+	release_native_buffer_func release_native_buffer;
+	uint32_t drm_format;
+	uint32_t slot;
+};
+
+static const struct wlr_buffer_impl buffer_impl;
+
+bool wlr_buffer_is_hybris(struct wlr_buffer *wlr_buffer) {
+	return wlr_buffer->impl == &buffer_impl;
+}
+
+static struct hybris_buffer *hybris_buffer_from_buffer(struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer_is_hybris(wlr_buffer));
+	struct hybris_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+void *wlr_hybris_buffer_get_native(struct wlr_buffer *wlr_buffer) {
+	return hybris_buffer_from_buffer(wlr_buffer)->native;
+}
+
+uint32_t wlr_hybris_buffer_get_slot(struct wlr_buffer *wlr_buffer) {
+	return hybris_buffer_from_buffer(wlr_buffer)->slot;
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct hybris_buffer *buffer = hybris_buffer_from_buffer(wlr_buffer);
+	buffer->release_native_buffer(buffer->native);
+	free(buffer);
+}
+
+/* gralloc buffers are dma-bufs underneath (first fd of the native handle) */
+static bool buffer_get_dmabuf(struct wlr_buffer *wlr_buffer,
+		struct wlr_dmabuf_attributes *attribs) {
+	struct hybris_buffer *buffer = hybris_buffer_from_buffer(wlr_buffer);
+	const struct hybris_native_handle *handle = buffer->native->handle;
+	if (handle == NULL || handle->num_fds < 1) {
+		return false;
+	}
+	*attribs = (struct wlr_dmabuf_attributes){
+		.width = wlr_buffer->width,
+		.height = wlr_buffer->height,
+		.format = buffer->drm_format,
+		.modifier = DRM_FORMAT_MOD_INVALID,
+		.n_planes = 1,
+		.offset = { 0 },
+		.stride = { (uint32_t)buffer->native->stride * 4 },
+		.fd = { handle->data[0] },
+	};
+	return true;
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+	.get_dmabuf = buffer_get_dmabuf,
+};
+
+static int hal_format_from_drm(uint32_t fmt) {
+	switch (fmt) {
+	// Everything is allocated as RGBA/RGBX: the composer reads BGRA client
+	// targets with red and blue swapped on this MTK HWC, and for a render target
+	// GL takes care of the channel order anyway. (Only CPU readback of an
+	// XRGB/ARGB buffer, e.g. screencopy, would see swapped channels.)
+	case DRM_FORMAT_ABGR8888:
+	case DRM_FORMAT_ARGB8888:
+		return HAL_PIXEL_FORMAT_RGBA_8888;
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_XRGB8888:
+		return HAL_PIXEL_FORMAT_RGBX_8888;
+	default:
+		return -1;
+	}
+}
+
+static struct hybris_allocator *hybris_allocator_from_allocator(
+		struct wlr_allocator *wlr_alloc);
+
+static struct wlr_buffer *allocator_create_buffer(struct wlr_allocator *wlr_alloc,
+		int width, int height, const struct wlr_drm_format *format) {
+	struct hybris_allocator *alloc = hybris_allocator_from_allocator(wlr_alloc);
+
+	int hal_format = hal_format_from_drm(format->format);
+	if (hal_format < 0) {
+		wlr_log(WLR_ERROR, "hybris allocator: unsupported format 0x%08"PRIX32,
+			format->format);
+		return NULL;
+	}
+
+	struct hybris_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+
+	EGLint stride;
+	EGLClientBuffer native;
+	if (!alloc->create_native_buffer(width, height,
+			GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_COMPOSER,
+			hal_format, &stride, &native)) {
+		wlr_log(WLR_ERROR, "hybris allocator: gralloc allocation of %dx%d failed",
+			width, height);
+		free(buffer);
+		return NULL;
+	}
+
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+	buffer->native = native;
+	buffer->release_native_buffer = alloc->release_native_buffer;
+	buffer->drm_format = format->format;
+	buffer->slot = alloc->next_slot++ % 64;
+
+	wlr_log(WLR_DEBUG, "Allocated %dx%d gralloc buffer (stride %d, slot %"PRIu32")",
+		width, height, stride, buffer->slot);
+	return &buffer->base;
+}
+
+static void allocator_destroy(struct wlr_allocator *wlr_alloc) {
+	free(hybris_allocator_from_allocator(wlr_alloc));
+}
+
+static const struct wlr_allocator_interface allocator_impl = {
+	.create_buffer = allocator_create_buffer,
+	.destroy = allocator_destroy,
+};
+
+static struct hybris_allocator *hybris_allocator_from_allocator(
+		struct wlr_allocator *wlr_alloc) {
+	assert(wlr_alloc->impl == &allocator_impl);
+	struct hybris_allocator *alloc = wl_container_of(wlr_alloc, alloc, base);
+	return alloc;
+}
+
+struct wlr_allocator *wlr_hybris_allocator_create(void) {
+	create_native_buffer_func create =
+		(create_native_buffer_func)eglGetProcAddress("eglHybrisCreateNativeBuffer");
+	release_native_buffer_func release =
+		(release_native_buffer_func)eglGetProcAddress("eglHybrisReleaseNativeBuffer");
+	if (create == NULL || release == NULL) {
+		wlr_log(WLR_ERROR, "hybris allocator: EGL_HYBRIS_native_buffer2 not available "
+			"(not running on libhybris' libEGL?)");
+		return NULL;
+	}
+
+	struct hybris_allocator *alloc = calloc(1, sizeof(*alloc));
+	if (alloc == NULL) {
+		return NULL;
+	}
+	wlr_allocator_init(&alloc->base, &allocator_impl, WLR_BUFFER_CAP_DMABUF);
+	alloc->create_native_buffer = create;
+	alloc->release_native_buffer = release;
+
+	wlr_log(WLR_INFO, "Created hybris (gralloc) allocator");
+	return &alloc->base;
+}
diff --git a/render/egl.c b/render/egl.c
index 8673aca..5947467 100644
--- a/render/egl.c
+++ b/render/egl.c
@@ -9,7 +9,9 @@
 #include <wlr/util/log.h>
 #include <wlr/util/region.h>
 #include <xf86drm.h>
+#include "config.h"
 #include "render/egl.h"
+#include "render/hybris.h"
 #include "util/env.h"
 
 static enum wlr_log_importance egl_log_importance_to_wlr(EGLint type) {
@@ -614,6 +616,58 @@ error:
 	return NULL;
 }
 
+#if HAVE_HWCOMPOSER
+struct wlr_egl *wlr_egl_create_hybris(void) {
+	// libhybris' libEGL has no client extensions (no platform_base, gbm or
+	// device platforms): use the default display, which is the Android driver.
+	struct wlr_egl *egl = calloc(1, sizeof(*egl));
+	if (egl == NULL) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		return NULL;
+	}
+	if (eglBindAPI(EGL_OPENGL_ES_API) == EGL_FALSE) {
+		wlr_log(WLR_ERROR, "Failed to bind to the OpenGL ES API");
+		goto error;
+	}
+	EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (display == EGL_NO_DISPLAY || !egl_init_display(egl, display, true)) {
+		wlr_log(WLR_ERROR, "Failed to initialize the libhybris EGL display");
+		goto error;
+	}
+
+	// No dma-buf import here, so nothing filled the render formats: advertise
+	// what the hybris allocator makes (gralloc RGBA/RGBX) so outputs can pick a
+	// swapchain format. gles2 renders into them via EGL_NATIVE_BUFFER_ANDROID.
+	// XRGB/ARGB first: wlroots prefers them for primary buffers (HAL BGRA_8888)
+	wlr_drm_format_set_add(&egl->dmabuf_render_formats, DRM_FORMAT_XRGB8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&egl->dmabuf_render_formats, DRM_FORMAT_ARGB8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&egl->dmabuf_render_formats, DRM_FORMAT_XBGR8888,
+		DRM_FORMAT_MOD_INVALID);
+	wlr_drm_format_set_add(&egl->dmabuf_render_formats, DRM_FORMAT_ABGR8888,
+		DRM_FORMAT_MOD_INVALID);
+
+	static const EGLint attribs[] = {
+		EGL_CONTEXT_CLIENT_VERSION, 2,
+		EGL_NONE,
+	};
+	egl->context = eglCreateContext(egl->display, EGL_NO_CONFIG_KHR,
+		EGL_NO_CONTEXT, attribs);
+	if (egl->context == EGL_NO_CONTEXT) {
+		wlr_log(WLR_ERROR, "Failed to create EGL context");
+		goto error;
+	}
+	egl->hybris = true;
+	wlr_log(WLR_INFO, "Created libhybris EGL context");
+	return egl;
+
+error:
+	free(egl);
+	return NULL;
+}
+#endif
+
