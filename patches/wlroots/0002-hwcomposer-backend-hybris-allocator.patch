+	void *(*display_create_layer)(void *display);
+	hwc2_error_t (*display_get_release_fences)(void *display, void **fences);
+	hwc2_error_t (*display_present)(void *display, int32_t *present_fence);
+	hwc2_error_t (*display_set_client_target)(void *display, uint32_t slot,
