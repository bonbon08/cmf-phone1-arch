diff --git a/render/hybris_wl_buffer.c b/render/hybris_wl_buffer.c
new file mode 100644
index 0000000..75be22f
--- /dev/null
+++ b/render/hybris_wl_buffer.c
@@ -0,0 +1,137 @@
+#include <assert.h>
+#include <EGL/egl.h>
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/util/log.h>
+#include "render/hybris.h"
+
+/*
+ * Client buffers of GPU-rendering apps on libhybris' EGL. Their wayland platform
+ * shares gralloc buffers through the android_wlegl protocol, which libhybris
+ * serves itself once the compositor calls eglBindWaylandDisplayWL (the old Mesa
+ * wl_drm model). Here those wl_buffers become wlr_buffers; the gles2 renderer
+ * turns them into textures with eglCreateImageKHR(EGL_WAYLAND_BUFFER_WL).
+ */
+
+#ifndef EGL_WAYLAND_BUFFER_WL
+#define EGL_WAYLAND_BUFFER_WL 0x31D5
+#endif
+
+typedef EGLBoolean (*bind_wayland_display_func)(EGLDisplay dpy, struct wl_display *display);
+typedef EGLBoolean (*query_wayland_buffer_func)(EGLDisplay dpy, struct wl_resource *buffer,
+	EGLint attribute, EGLint *value);
+
+static EGLDisplay hybris_display = EGL_NO_DISPLAY;
+static query_wayland_buffer_func query_wayland_buffer;
+
+struct hybris_wl_buffer {
+	struct wlr_buffer base;
+	struct wl_resource *resource;
+	struct wl_listener resource_destroy;
+	struct wl_listener release;
+};
+
+static const struct wlr_buffer_impl buffer_impl;
+
+bool wlr_buffer_is_hybris_wl(struct wlr_buffer *wlr_buffer) {
+	return wlr_buffer->impl == &buffer_impl;
+}
+
+static struct hybris_wl_buffer *hybris_wl_buffer_from_buffer(struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer_is_hybris_wl(wlr_buffer));
+	struct hybris_wl_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+struct wl_resource *wlr_hybris_wl_buffer_get_resource(struct wlr_buffer *wlr_buffer) {
+	return hybris_wl_buffer_from_buffer(wlr_buffer)->resource;
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct hybris_wl_buffer *buffer = hybris_wl_buffer_from_buffer(wlr_buffer);
+	wl_list_remove(&buffer->release.link);
+	if (buffer->resource != NULL) {
+		wl_list_remove(&buffer->resource_destroy.link);
+	}
+	wlr_buffer_finish(wlr_buffer);
+	free(buffer);
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+};
+
+static void handle_resource_destroy(struct wl_listener *listener, void *data) {
+	struct hybris_wl_buffer *buffer = wl_container_of(listener, buffer, resource_destroy);
+	wl_list_remove(&buffer->resource_destroy.link);
+	buffer->resource = NULL;
+	wlr_buffer_drop(&buffer->base);
+}
+
+static void handle_release(struct wl_listener *listener, void *data) {
+	struct hybris_wl_buffer *buffer = wl_container_of(listener, buffer, release);
+	if (buffer->resource != NULL) {
+		wl_buffer_send_release(buffer->resource);
+	}
+}
+
+static bool resource_is_instance(struct wl_resource *resource) {
+	EGLint format;
+	return query_wayland_buffer != NULL &&
+		query_wayland_buffer(hybris_display, resource, EGL_TEXTURE_FORMAT, &format);
+}
+
+static struct wlr_buffer *buffer_from_resource(struct wl_resource *resource) {
+	// The resource's user data belongs to libhybris, so find ours via the
+	// destroy listener
+	struct wl_listener *listener =
+		wl_resource_get_destroy_listener(resource, handle_resource_destroy);
+	if (listener != NULL) {
+		struct hybris_wl_buffer *buffer =
+			wl_container_of(listener, buffer, resource_destroy);
+		return &buffer->base;	// the caller locks
+	}
+
+	EGLint width, height;
+	if (!query_wayland_buffer(hybris_display, resource, EGL_WIDTH, &width) ||
+			!query_wayland_buffer(hybris_display, resource, EGL_HEIGHT, &height)) {
+		return NULL;
+	}
+
+	struct hybris_wl_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+	buffer->resource = resource;
+	buffer->resource_destroy.notify = handle_resource_destroy;
+	wl_resource_add_destroy_listener(resource, &buffer->resource_destroy);
+	buffer->release.notify = handle_release;
+	wl_signal_add(&buffer->base.events.release, &buffer->release);
+	return &buffer->base;
+}
+
+static const struct wlr_buffer_resource_interface resource_interface = {
+	.name = "hybris_wl_buffer",
+	.is_instance = resource_is_instance,
+	.from_resource = buffer_from_resource,
+};
+
+bool wlr_hybris_wl_display_init(void *display, struct wl_display *wl_display) {
+	bind_wayland_display_func bind =
+		(bind_wayland_display_func)eglGetProcAddress("eglBindWaylandDisplayWL");
+	query_wayland_buffer_func query =
+		(query_wayland_buffer_func)eglGetProcAddress("eglQueryWaylandBufferWL");
+	if (bind == NULL || query == NULL || !bind(display, wl_display)) {
+		wlr_log(WLR_ERROR, "libhybris EGL_WL_bind_wayland_display unavailable: "
+			"clients can't share GPU buffers (they'll use shm)");
+		return false;
+	}
+	hybris_display = display;
+	query_wayland_buffer = query;
+	wlr_buffer_register_resource_interface(&resource_interface);
+	wlr_log(WLR_INFO, "android_wlegl (libhybris) bound: GPU-rendered client buffers enabled");
+	return true;
+}
