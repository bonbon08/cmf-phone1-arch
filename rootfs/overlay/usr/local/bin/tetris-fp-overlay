#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-or-later
# Light spot for the CMF Phone 1's optical under-display fingerprint sensor: an overlay
# (layer shell, above the lock screen) with a white disc over the sensor, which lights
# the finger for the sensor (the fingerprint HAL turns on high brightness itself).
# Usage: tetris-fp-overlay [x y radius]   (display pixels; default: this phone's sensor)
import sys
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GtkLayerShell, GLib

x, y, r = (int(v) for v in sys.argv[1:4]) if len(sys.argv) >= 4 else (540, 2109, 93)
# light more than the sensor itself: with only its radius lit, enrollment images come out
# just below the trusted app's quality threshold (check q(13) failed)
r = int(r * 1.4)
PHYS_W = 1080

win = Gtk.Window()
GtkLayerShell.init_for_window(win)
GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
GtkLayerShell.set_namespace(win, "tetris-fp")
GtkLayerShell.set_exclusive_zone(win, -1)
for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT):
    GtkLayerShell.set_anchor(win, edge, True)

mon = Gdk.Display.get_default().get_monitor(0)
scale = PHYS_W / mon.get_geometry().width
size = int(2 * r / scale) + 2
GtkLayerShell.set_margin(win, GtkLayerShell.Edge.LEFT, int((x - r) / scale))
GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, int((y - r) / scale))
win.set_size_request(size, size)
win.set_app_paintable(True)
screen = win.get_screen()
if screen.get_rgba_visual():
    win.set_visual(screen.get_rgba_visual())


def draw(widget, cr):
    cr.set_source_rgba(0, 0, 0, 0)
    cr.set_operator(0)  # CLEAR
    cr.paint()
    cr.set_operator(2)  # OVER
    cr.set_source_rgb(1, 1, 1)
    cr.arc(size / 2, size / 2, size / 2 - 1, 0, 6.2832)
    cr.fill()


win.connect("draw", draw)
# don't take touches: the fingerprint daemon reads them from the touchscreen itself
win.connect("realize", lambda w: w.get_window().input_shape_combine_region(
    __import__("cairo").Region(), 0, 0))
win.connect("destroy", Gtk.main_quit)
win.show_all()
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, Gtk.main_quit)
Gtk.main()
