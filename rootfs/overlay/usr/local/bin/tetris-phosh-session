#!/bin/sh
# ExecStart of tetris-phosh (as alarm): run the Phosh variant tetris-phosh-select chose.
# Phosh runs under the systemd user manager, whose environment lacks this login session's
# id; without it Phosh doesn't follow logind's Lock/Unlock nor set LockedHint (needed
# by the fingerprint unlock, tetris-fpd).
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"
export DBUS_SESSION_BUS_ADDRESS
[ -n "$XDG_SESSION_ID" ] && systemctl --user import-environment XDG_SESSION_ID
if [ "$(cat /run/tetris-phosh/mode 2>/dev/null)" = gpu ]; then
    exec /usr/local/bin/tetris-phosh-session-hwc
fi
export WLR_RENDERER=pixman
exec /usr/bin/phosh-session
