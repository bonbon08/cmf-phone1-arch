#!/usr/bin/env python3
# Fingerprint enrollment with live feedback: runs "tetris-fp enroll" (as root, see
# /etc/sudoers.d/tetris-fp), turns the HAL's messages into hints and counts the touches left.
import subprocess
import threading

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

TP = "/usr/local/bin/tetris-fp"

HINTS = {
    "good": "Gut, weiter so",
    "too fast": "Zu kurz: Finger 2 bis 3 Sekunden aufliegen lassen",
    "too slow": "Zu langsam: Finger zügiger auflegen",
    "sensor dirty": "Sensor verschmutzt: Stelle abwischen",
    "partial": "Nur teilweise erfasst: Finger mittiger auflegen",
    "insufficient": "Zu wenig Fläche erfasst: Finger flach aufsetzen",
    "too dark": "Zu dunkel: Display kurz hell lassen und nochmal",
    "too bright": "Zu hell: Finger leicht versetzt auflegen",
    "immobile": "Finger leicht bewegen",
    "lift finger": "Finger abheben",
    "touch": "Finger auflegen",
    "retrying capture": "Erneut versuchen",
}
ERRORS = {
    "error 3": "Zeit abgelaufen: nichts erkannt",
    "error 5": "Abgebrochen",
}


class Enroll(Gtk.Window):
    def __init__(self):
        super().__init__(title="Fingerabdruck einrichten")
        self.set_default_size(360, 420)
        self.set_border_width(16)
        self.proc = None
        self.total = None
        self.counts = {"zu kurz": 0, "zu langsam": 0, "sonstiges": 0}

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(box)
        self.big = Gtk.Label(label="Bereit")
        self.big.get_style_context().add_class("title-1")
        box.pack_start(self.big, False, False, 0)
        self.hint = Gtk.Label(label="Tippe auf Start und lege den Finger auf die Stelle unten in der Mitte.")
        self.hint.set_line_wrap(True)
        box.pack_start(self.hint, False, False, 0)
        self.bar = Gtk.ProgressBar()
        box.pack_start(self.bar, False, False, 0)
        self.stats = Gtk.Label(label="")
        self.stats.set_xalign(0)
        box.pack_start(self.stats, False, False, 0)
        self.button = Gtk.Button(label="Start")
        self.button.connect("clicked", self.on_button)
        box.pack_end(self.button, False, False, 0)
        self.connect("destroy", lambda *_: self.stop())

    def on_button(self, _btn):
        if self.proc:
            self.stop()
            return
        self.total = None
        self.counts = {"zu kurz": 0, "zu langsam": 0, "sonstiges": 0}
        self.bar.set_fraction(0)
        self.big.set_text("Läuft")
        self.button.set_label("Abbrechen")
        self.proc = subprocess.Popen(["sudo", "-n", TP, "enroll"], stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=1)
        threading.Thread(target=self.read, args=(self.proc,), daemon=True).start()

    def stop(self):
        if self.proc:
            self.proc.terminate()

    def read(self, proc):
        for line in proc.stdout:
            GLib.idle_add(self.handle, line.strip())
        rc = proc.wait()
        GLib.idle_add(self.finished, rc)

    def handle(self, line):
        if line.startswith("enroll:"):
            left = int(line.split(",")[-1].split()[0])
            if self.total is None:
                self.total = left + 1
            done = self.total - left
            self.bar.set_fraction(done / self.total)
            self.big.set_text(f"Noch {left}")
            self.hint.set_text(f"{done} von {self.total} erfasst. Weiter so!")
        elif line.startswith("acquired:"):
            name = line[len("acquired:"):].strip().split(" (")[0]
            if name == "too fast":
                self.counts["zu kurz"] += 1
            elif name == "too slow":
                self.counts["zu langsam"] += 1
            elif name not in ("good", "vendor", "start", "unknown"):
                self.counts["sonstiges"] += 1
            if name in HINTS and name != "good":
                self.hint.set_text(HINTS[name])
        elif line in ERRORS:
            self.hint.set_text(ERRORS[line])
        self.stats.set_text(
            f"Zu kurz: {self.counts['zu kurz']}   Zu langsam: {self.counts['zu langsam']}"
            f"   Sonstiges: {self.counts['sonstiges']}")
        return False

    def finished(self, rc):
        self.proc = None
        self.button.set_label("Start")
        if rc == 0:
            self.big.set_text("Fertig")
            self.hint.set_text("Der Finger ist eingerichtet. Der Sperrbildschirm erkennt ihn jetzt.")
            self.bar.set_fraction(1)
        else:
            self.big.set_text("Nicht fertig")
            if not self.hint.get_text().startswith(("Zu ", "Zeit", "Abgebrochen")):
                self.hint.set_text("Die Registrierung wurde nicht abgeschlossen. Nochmal versuchen.")
        return False


if __name__ == "__main__":
    win = Enroll()
    win.show_all()
    Gtk.main()
